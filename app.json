{
  "expo": {
    "name": "Bloom",
    "slug": "bloom",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "splash": {
      "resizeMode": "contain",
      "backgroundColor": "#F6F8E9"
    },
    "ios": {
      "supportsTablet": true,
      "infoPlist": {
        "NSCameraUsageDescription": "Bloom uses the camera to scan product barcodes."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F6F8E9"
      },
      "permissions": [
        "CAMERA"
      ]
    },
    "plugins": [
      "expo-font"
    ]
  }
}
